.root-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 36px 48px;
    background-color: rgba(6, 8, 14, 0.78); /* Tela cheia elegante com leve transparência para ver a iluminação 3D */
    font-size: 15px;
    color: #ffffff;
}

.header-label {
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
    border-left-width: 4px;
    border-left-color: #f39c12;
    padding-left: 12px;
}

/* Painel Esquerdo (Menu de Ações) */
.menu-panel {
    width: 290px;
}

.menu-button {
    height: 46px;
    margin-bottom: 10px;
    background-color: rgba(22, 25, 34, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    color: #e0e0e0;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-left;
    padding-left: 18px;
    transition-duration: 0.15s;
    border-radius: 6px;
}

.menu-button:hover {
    background-color: rgba(243, 156, 18, 0.3);
    border-color: #f39c12;
    color: #ffffff;
}

.menu-button:focus {
    border-color: #f39c12;
    border-width: 2px;
}

/* Área Central com Setas de Navegação e Carrossel */
.carousel-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-left: 20px;
    margin-right: 20px;
    height: 380px;
}

.nav-arrow-button {
    width: 64px;
    height: 110px;
    background-color: rgba(22, 26, 38, 0.88);
    border-width: 2px;
    border-color: rgba(243, 156, 18, 0.45);
    border-radius: 8px;
    color: #f39c12;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.nav-arrow-button:hover {
    background-color: #f39c12;
    color: #121212;
    border-color: #ffffff;
    scale: 1.05;
}

.preview-panel {
    width: 520px;
    height: 340px;
    margin-left: 24px;
    margin-right: 24px;
    background-color: rgba(14, 18, 28, 0.9);
    border-width: 2px;
    border-color: rgba(243, 156, 18, 0.4);
    border-radius: 12px;
    padding: 18px;
    align-items: center;
    justify-content: center;
}

.preview-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Painel Direito (Estatísticas e Specs) */
.stats-panel {
    width: 320px;
    background-color: rgba(18, 22, 32, 0.92);
    padding: 22px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 8px;
}

.stat-row {
    margin-bottom: 14px;
}

.stat-label-container {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
}

.stat-label {
    font-size: 13px;
    color: #c0c0c0;
    -unity-font-style: bold;
}

.stat-bar-background {
    height: 10px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
}

.stat-bar-fill {
    height: 100%;
    background-color: #f39c12;
    border-radius: 3px;
}

.specs-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.18);
    margin-top: 16px;
    margin-bottom: 16px;
}

.spec-item {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.spec-title {
    color: #9a9a9a;
    font-size: 13px;
}

.spec-value {
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}

/* Modal / Subtelas (Options / Viabilidade) */
.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.92);
    align-items: center;
    justify-content: center;
}

.modal-window {
    width: 620px;
    background-color: rgba(18, 22, 32, 0.98);
    border-width: 2px;
    border-color: #f39c12;
    border-radius: 10px;
    padding: 28px;
}

.modal-header {
    font-size: 24px;
    -unity-font-style: bold;
    color: #f39c12;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.18);
    padding-bottom: 10px;
}

.option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.option-label {
    font-size: 15px;
    color: #e0e0e0;
    -unity-font-style: bold;
    width: 200px;
}

.option-slider {
    flex-grow: 1;
}

.modal-close-btn {
    height: 44px;
    margin-top: 22px;
    background-color: #f39c12;
    color: #121212;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 6px;
    border-width: 0;
}

.modal-close-btn:hover {
    background-color: #ffa726;
}

/* Tabela de Viabilidade dos Carros */
.viability-table {
    margin-top: 10px;
    margin-bottom: 10px;
}

.viability-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.viability-cell-name {
    width: 180px;
    font-size: 14px;
    color: #ffffff;
    -unity-font-style: bold;
}

.viability-cell-status {
    width: 120px;
    font-size: 13px;
    -unity-font-style: bold;
}

.status-ok {
    color: #43bdb0;
}

.status-warn {
    color: #f39c12;
}

.viability-cell-poly {
    font-size: 13px;
    color: #a8a8a8;
}

/* Rodapé */
.footer-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 16px;
}

.car-title-label {
    font-size: 36px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #ffffff;
}

.footer-nav {
    flex-direction: row;
    color: #9a9a9a;
    font-size: 14px;
}

.footer-nav-item {
    margin-left: 20px;
}
